{
  "name": "docuforge",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first documentary production studio",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "tsc -p frontend/tsconfig.json --noEmit && vite build --config frontend/vite.config.ts",
    "test": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run build && npm run test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.108.2",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
